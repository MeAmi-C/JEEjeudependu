<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ page import="example.HangmanGame" %>
<%
    HangmanGame game = (HangmanGame) session.getAttribute("game");
%>
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Jeu de Pendu - En Cours</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            text-align: center;
            margin-top: 50px;
            background-color: #f0f0f0;
        }
        h1 {
            color: #333;
        }
        .word-display {
            font-size: 24px;
            letter-spacing: 5px;
            margin: 20px 0;
        }
        .attempts {
            color: #d9534f;
            font-weight: bold;
        }
        .guess-form {
            margin: 20px 0;
        }
        .guess-input {
            padding: 5px;
            font-size: 16px;
            width: 30px;
            text-align: center;
            text-transform: uppercase;
        }
        .guess-button {
            padding: 5px 15px;
            font-size: 16px;
            background-color: #337ab7;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }
        .guess-button:hover {
            background-color: #286090;
        }
        .used-letters {
            margin-top: 20px;
            color: #777;
        }
    </style>
</head>
<body>
    <h1>Jeu de Pendu</h1>
    
    <div class="word-display">
        <%= game.getDisplayWord() %>
    </div>
    
    <div class="attempts">
        Tentatives restantes: <%= game.getRemainingAttempts() %>
    </div>
    
    <form class="guess-form" action="HangmanServlet" method="post">
        <input type="text" class="guess-input" name="letter" maxlength="1" required 
               pattern="[A-Za-z]" title="Veuillez entrer une seule lettre">
        <input type="submit" class="guess-button" value="Deviner">
    </form>
    
    <div class="used-letters">
        Lettres utilisées: 
        <% for (char c : game.getGuessedLetters()) { %>
            <%= c %> 
        <% } %>
    </div>
    
    <script>
        // Focus the input field on page load
        document.querySelector('.guess-input').focus();
        
        // Convert input to uppercase automatically
        document.querySelector('.guess-input').addEventListener('input', function(e) {
            this.value = this.value.toUpperCase();
        });
    </script>
</body>
</html>
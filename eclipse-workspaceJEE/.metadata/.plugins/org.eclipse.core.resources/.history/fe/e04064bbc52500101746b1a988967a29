<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ page import="example.HangmanGame" %>
<%
    HangmanGame game = (HangmanGame) session.getAttribute("game");
%>
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Dark Comedy Hangman</title>
    <style>
        body {
            font-family: 'Courier New', monospace;
            background-color: #121212;
            color: #e0e0e0;
            text-align: center;
            margin: 0;
            padding: 20px;
        }
        
        .game-container {
            max-width: 800px;
            margin: 0 auto;
            background-color: #222;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 0 20px rgba(255, 0, 0, 0.3);
        }
        
        h1 {
            color: #ff4444;
            text-shadow: 0 0 5px rgba(255, 0, 0, 0.5);
        }
        
        .scene {
            margin: 20px auto;
            position: relative;
            height: 300px;
            background-color: #333;
            border-radius: 5px;
            overflow: hidden;
        }
        
        .victim {
            position: absolute;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            width: 100px;
            height: 150px;
            background-color: #555;
            border-radius: 5px;
        }
        
        .victim-head {
            position: absolute;
            top: -30px;
            left: 50%;
            transform: translateX(-50%);
            width: 40px;
            height: 40px;
            background-color: #ffdbac;
            border-radius: 50%;
        }
        
        .executioner {
            position: absolute;
            bottom: 20px;
            right: 50px;
            width: 80px;
            height: 180px;
            background-color: #444;
        }
        
        .pistol {
            position: absolute;
            top: 50px;
            right: -30px;
            width: 60px;
            height: 20px;
            background-color: #999;
            transform: rotate(-30deg);
        }
        
        .word-display {
            font-size: 32px;
            letter-spacing: 10px;
            margin: 30px 0;
            color: #fff;
            text-shadow: 0 0 5px rgba(255, 255, 255, 0.3);
        }
        
        .attempts {
            color: #ff4444;
            font-weight: bold;
            font-size: 18px;
        }
        
        .guess-form {
            margin: 20px 0;
        }
        
        .guess-input {
            padding: 10px;
            font-size: 18px;
            width: 40px;
            text-align: center;
            background-color: #333;
            color: white;
            border: 1px solid #ff4444;
            border-radius: 5px;
        }
        
        .guess-button {
            padding: 10px 20px;
            font-size: 16px;
            background-color: #ff4444;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            transition: all 0.3s;
        }
        
        .guess-button:hover {
            background-color: #ff0000;
            transform: scale(1.05);
        }
        
        .used-letters {
            margin-top: 20px;
            color: #aaa;
            font-style: italic;
        }
        
        /* Animation for wrong guesses */
        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-5px); }
            75% { transform: translateX(5px); }
        }
        
        .shake {
            animation: shake 0.3s ease-in-out;
        }
        
        /* Animation for pistol shot */
        @keyframes pistolShot {
            0% { transform: rotate(-30deg); }
            50% { transform: rotate(-10deg) translateX(10px); }
            100% { transform: rotate(-30deg); }
        }
        
        .shot {
            animation: pistolShot 0.5s ease-in-out;
        }
    </style>
</head>
<body>
    <div class="game-container">
        <h1>CRIME SCENE HANGMAN</h1>
        
        <div class="scene">
            <div class="victim">
                <div class="victim-head"></div>
            </div>
            <div class="executioner">
                <div class="pistol" id="pistol"></div>
            </div>
        </div>
        
        <div class="word-display">
            <%= game.getDisplayWord() %>
        </div>
        
        <div class="attempts">
            Wrong attempts left: <%= game.getRemainingAttempts() %> 
            <span id="attemptMessage"></span>
        </div>
        
        <form class="guess-form" action="HangmanServlet" method="post">
            <input type="text" class="guess-input" name="letter" maxlength="1" required 
                   pattern="[A-Za-z]" title="Please enter a single letter">
            <input type="submit" class="guess-button" value="GUESS">
        </form>
        
        <div class="used-letters">
            Used letters: 
            <% for (char c : game.getGuessedLetters()) { %>
                <%= c %> 
            <% } %>
        </div>
    </div>
    
    <script>
        // Focus the input field on page load
        document.querySelector('.guess-input').focus();
        
        // Convert input to uppercase automatically
        document.querySelector('.guess-input').addEventListener('input', function(e) {
            this.value = this.value.toUpperCase();
        });
        
        // Animation for wrong guesses
        <% if (!game.getGuessedLetters().isEmpty() && 
              game.getWordToGuess().indexOf(game.getGuessedLetters().get(game.getGuessedLetters().size()-1)) < 0) { %>
            document.querySelector('.victim').classList.add('shake');
            document.getElementById('pistol').classList.add('shot');
            
            // Update attempt message with dark humor
            const messages = [
                "The executioner is getting impatient...",
                "That tickled the wrong way!",
                "The victim sweats nervously...",
                "One step closer to the 'big bang'!",
                "The pistol is being loaded... with confetti?"
            ];
            document.getElementById('attemptMessage').textContent = 
                " - " + messages[<%= game.getRemainingAttempts() % 5 %>];
            
            // Remove animation classes after they play
            setTimeout(() => {
                document.querySelector('.victim').classList.remove('shake');
                document.getElementById('pistol').classList.remove('shot');
            }, 1000);
        <% } %>
    </script>
</body>
</html>
<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ page import="example.HangmanGame" %>
<%
    HangmanGame game = (HangmanGame) session.getAttribute("game");
    boolean won = game.isGameWon();
    session.removeAttribute("game");
    String resultClass = won ? "won" : "lost";
%>
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Game Over - Dark Comedy Hangman</title>
    <style>
        body {
            font-family: 'Courier New', monospace;
            background-color: #121212;
            color: #e0e0e0;
            text-align: center;
            margin: 0;
            padding: 20px;
        }
        
        .game-container {
            max-width: 800px;
            margin: 0 auto;
            background-color: #222;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 0 20px rgba(255, 0, 0, 0.3);
        }
        
        h1 {
            color: #ff4444;
            text-shadow: 0 0 5px rgba(255, 0, 0, 0.5);
        }
        
        .result {
            font-size: 24px;
            margin: 20px 0;
        }
        
        .word {
            font-weight: bold;
            color: #ff4444;
            font-size: 28px;
            letter-spacing: 5px;
        }
        
        .play-again {
            padding: 10px 20px;
            font-size: 16px;
            background-color: #ff4444;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            transition: all 0.3s;
            margin-top: 30px;
        }
        
        .play-again:hover {
            background-color: #ff0000;
            transform: scale(1.05);
        }
        
        .won {
            color: #44ff44;
        }
        
        .lost {
            color: #ff4444;
        }
        
        .scene {
            margin: 20px auto;
            position: relative;
            height: 300px;
            background-color: #333;
            border-radius: 5px;
            overflow: hidden;
        }
        
        .victim {
            position: absolute;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            width: 100px;
            height: 150px;
            background-color: #555;
            border-radius: 5px;
        }
        
        .victim-head {
            position: absolute;
            top: -30px;
            left: 50%;
            transform: translateX(-50%);
            width: 40px;
            height: 40px;
            background-color: #ffdbac;
            border-radius: 50%;
        }
        
        <% if (!won) { %>
        .victim-head:after {
            content: "X_X";
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            color: red;
            font-size: 20px;
        }
        <% } else { %>
        .victim-head:after {
            content: "^_^";
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            color: green;
            font-size: 20px;
        }
        <% } %>
        
        .executioner {
            position: absolute;
            bottom: 20px;
            right: 50px;
            width: 80px;
            height: 180px;
            background-color: #444;
        }
        
        .pistol {
            position: absolute;
            top: 50px;
            right: -30px;
            width: 60px;
            height: 20px;
            background-color: #999;
            transform: rotate(-30deg);
        }
        
        <% if (!won) { %>
        .confetti {
            position: absolute;
            width: 10px;
            height: 10px;
            background-color: #f00;
            opacity: 0;
        }
        <% } %>
    </style>
</head>
<body>
    <div class="game-container">
        <h1>GAME OVER</h1>
        
        <div class="scene">
            <div class="victim">
                <div class="victim-head"></div>
            </div>
            <div class="executioner">
                <div class="pistol"></div>
            </div>
            <% if (!won) { %>
                <div id="confetti-container"></div>
            <% } %>
        </div>
        
        <div class="result <%= resultClass %>">
            <% if (won) { %>
                CONGRATULATIONS! The hostage is safe... for now.
            <% } else { %>
                GAME OVER! The executioner had his fun... with a toy pistol.
            <% } %>
        </div>
        
        <div>
            The word was: <span class="word"><%= game.getWordToGuess() %></span>
        </div>
        
        <form action="HangmanServlet" method="get">
            <input type="submit" class="play-again" value="PLAY AGAIN">
        </form>
    </div>
    
    <% if (!won) { %>
    <script>
        // Create confetti effect
        const container = document.getElementById('confetti-container');
        const colors = ['#f00', '#0f0', '#00f', '#ff0', '#f0f', '#0ff'];
        
        for (let i = 0; i < 50; i++) {
            const confetti = document.createElement('div');
            confetti.className = 'confetti';
            confetti.style.backgroundColor = colors[Math.floor(Math.random() * colors.length)];
            confetti.style.left = Math.random() * 100 + '%';
            confetti.style.top = Math.random() * 100 + '%';
            confetti.style.transform = 'rotate(' + Math.random() * 360 + 'deg)';
            
            // Animation
            confetti.style.animation = `fall ${Math.random() * 3 + 2}s ease-in forwards`;
            confetti.style.animationDelay = Math.random() * 0.5 + 's';
            
            container.appendChild(confetti);
        }
        
        // Add styles for confetti
        const style = document.createElement('style');
        style.textContent = `
            @keyframes fall {
                0% { 
                    opacity: 1;
                    transform: translateY(-100px) rotate(0deg);
                }
                100% { 
                    opacity: 0;
                    transform: translateY(300px) rotate(360deg);
                }
            }
        `;
        document.head.appendChild(style);
    </script>
    <% } %>
</body>
</html>